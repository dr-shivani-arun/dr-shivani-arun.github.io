---
export interface Props {
  title: string;
  authors: string[];
  venue?: string;
  date: Date;
  category: string;
  abstract?: string;
  url?: string;
  pdf?: string;
  slug: string;
}

const { title, authors, venue, date, category, abstract, url, pdf } = Astro.props;

const categoryColors: Record<string, string> = {
  'Oral-Systemic Link':  'bg-teal-100 text-teal-800',
  'Health Literacy':     'bg-sky-100 text-sky-800',
  'Epidemiology':        'bg-indigo-100 text-indigo-800',
  'IISc Project':        'bg-violet-100 text-violet-800',
  'MOOC Development':    'bg-amber-100 text-amber-800',
  'Community Health':    'bg-emerald-100 text-emerald-800',
};

const badgeClass = categoryColors[category] ?? 'bg-slate-100 text-slate-700';
const year = date.getFullYear();
---

<article class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-lg hover:border-teal-200 transition-all duration-300 flex flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <span class:list={['text-xs font-semibold px-2.5 py-1 rounded-full shrink-0', badgeClass]}>
      {category}
    </span>
    <span class="text-xs text-slate-400 shrink-0 mt-0.5">{year}</span>
  </div>

  <h3 class="font-semibold text-slate-900 leading-snug text-base">{title}</h3>

  <p class="text-sm text-slate-500 italic">
    {authors.join(', ')}
    {venue && <> · <span class="not-italic text-slate-600">{venue}</span></>}
  </p>

  {abstract && (
    <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">{abstract}</p>
  )}

  {(url || pdf) && (
    <div class="flex gap-3 mt-auto pt-2">
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer"
           class="text-xs font-medium text-sky-600 hover:text-sky-800 flex items-center gap-1 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          View Paper
        </a>
      )}
      {pdf && (
        <a href={pdf} target="_blank" rel="noopener noreferrer"
           class="text-xs font-medium text-teal-600 hover:text-teal-800 flex items-center gap-1 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          PDF
        </a>
      )}
    </div>
  )}
</article>
