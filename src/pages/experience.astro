---

<BaseLayout
  title="Experience"
  description="Dr. Shivani Arun's professional experience in public health research, project coordination, MOOC development, and clinical dentistry."
>
  <Nav slot="nav" />

  <!-- Page header -->
  <section class="bg-gradient-to-br from-teal-900 via-sky-900 to-slate-900 text-white py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-teal-300 text-sm font-semibold uppercase tracking-wider">Career</span>
      <h1 class="text-4xl font-bold mt-2 mb-4">Experience</h1>
      <p class="text-slate-300 max-w-2xl">
        From clinical dentistry to public health research, MOOC development to community advocacy —
        a career dedicated to advancing health equity.
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-6 top-0 bottom-0 w-px bg-slate-200 hidden sm:block"></div>

      <div class="space-y-8">
        {experience.map(({ title, org, period, duration, location, type, current, bullets, tags }) => (
          <div class="relative sm:pl-16">
            <!-- Dot -->
            <div class:list={[
              'absolute left-4 top-5 w-4 h-4 rounded-full border-2 border-white shadow hidden sm:flex items-center justify-center -translate-x-1/2',
              current ? 'bg-teal-500' : 'bg-slate-300',
            ]}></div>

            <div class:list={[
              'bg-white border rounded-2xl p-6 hover:shadow-md transition-all',
              current ? 'border-teal-200 shadow-sm ring-1 ring-teal-100' : 'border-slate-200',
            ]}>
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-bold text-slate-900 text-base">{title}</h3>
                    {current && (
                      <span class="text-xs bg-teal-100 text-teal-700 font-semibold px-2 py-0.5 rounded-full">Current</span>
                    )}
                  </div>
                  <p class="text-teal-700 font-medium text-sm mt-0.5">{org}</p>
                  <p class="text-slate-500 text-xs mt-0.5">{type} · {location}</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-sm font-medium text-slate-700">{period}</p>
                  <p class="text-xs text-slate-400">{duration}</p>
                </div>
              </div>

              {bullets.length > 0 && (
                <ul class="space-y-1.5 mb-4">
                  {bullets.map((b) => (
                    <li class="text-sm text-slate-600 flex items-start gap-2">
                      <svg class="w-3.5 h-3.5 text-teal-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                      {b}
                    </li>
                  ))}
                </ul>
              )}

              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded-md">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
