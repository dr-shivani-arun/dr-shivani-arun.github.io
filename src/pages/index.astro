---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ResearchCard from '../components/ResearchCard.astro';
import HealthEducationCard from '../components/HealthEducationCard.astro';
import { getCollection } from 'astro:content';

const allResearch = await getCollection('research');
const featured = allResearch.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

const allHealthEd = await getCollection('healthEducation');
const featuredHealthEd = allHealthEd.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

const highlights = [
  { icon: '🏅', label: 'University Gold Medalist', sub: 'MPH — JSS University' },
  { icon: '🏆', label: 'College Topper & Gold Medalist', sub: 'BDS — RGUHS' },
  { icon: '🔬', label: 'IISc Bengaluru', sub: 'Senior Project Associate' },
  { icon: '🌍', label: '500+ Health Workers', sub: 'Trained via MOOC' },
];

const skills = [
  'SPSS', 'QGIS', 'NVivo', 'ERDAS Imagine',
  'Curriculum Development', 'Data Visualisation',
  'Policy Analysis', 'Community Engagement',
  'R Programming', 'Systematic Reviews',
];
---

<BaseLayout
  title="Dr. Shivani Arun"
  description="Dentist · Public Health Researcher & Advocate · Health Educator · IISc Bengaluru. MPH Gold Medalist working on oral health equity, MOOCs, and community health."
>
  <Nav slot="nav" />

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  HERO                                    ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-teal-900 via-sky-900 to-slate-900 text-white">
    <!-- Decorative blobs -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-sky-500/20 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Text -->
        <div class="animate-slide-up">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-500/30 text-teal-300 text-sm font-medium mb-6">
            <span class="w-2 h-2 bg-teal-400 rounded-full animate-pulse"></span>
            Senior Project Associate · IISc Bengaluru
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-4">
            Dr. Shivani<br/>
            <span class="bg-gradient-to-r from-teal-300 to-sky-300 bg-clip-text text-transparent">Arun</span>
          </h1>

          <p class="text-slate-300 text-lg leading-relaxed mb-8 max-w-lg">
            Dentist · Public Health Researcher &amp; Advocate · Health Educator ·
            MPH Gold Medalist — bridging clinical expertise with evidence-based
            public health to advance health equity.
          </p>

          <div class="flex flex-wrap gap-3">
            <a href="/about"
               class="px-6 py-3 rounded-xl bg-gradient-to-r from-teal-500 to-sky-500 text-white font-semibold shadow-lg hover:shadow-teal-500/25 hover:opacity-90 transition-all">
              About Me
            </a>
            <a href="/research"
               class="px-6 py-3 rounded-xl bg-white/10 border border-white/20 text-white font-semibold backdrop-blur hover:bg-white/20 transition-all">
              View Research
            </a>
            <a href="mailto:drshivania07@gmail.com"
               class="px-6 py-3 rounded-xl bg-white/10 border border-white/20 text-white font-semibold backdrop-blur hover:bg-white/20 transition-all flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Contact
            </a>
          </div>

          <div class="mt-8 flex items-center gap-4 text-sm text-slate-400">
            <a href="https://www.linkedin.com/in/shivani-arun/" target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-1.5 hover:text-teal-300 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 [...]"/>
              </svg>
              LinkedIn
            </a>
            <span>·</span>
            <span>Greater Bengaluru Area</span>
          </div>
        </div>

        <!-- Avatar -->
        <div class="flex justify-center md:justify-end">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-br from-teal-400/30 to-sky-400/20 rounded-[2rem] blur-2xl"></div>
            <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-3xl overflow-hidden border-4 border-white/20 shadow-2xl">
              <img src="/avatar.svg" alt="Dr. Shivani Arun" class="w-full h-full object-cover"/>
            </div>
            <!-- Floating badge -->
            <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl shadow-xl px-4 py-3">
              <div class="text-xs text-slate-500 font-medium">Currently at</div>
              <div class="text-sm font-bold text-slate-900">IISc Bengaluru</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  HIGHLIGHTS                              ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {highlights.map(({ icon, label, sub }) => (
          <div class="text-center p-4">
            <div class="text-3xl mb-2">{icon}</div>
            <div class="font-bold text-slate-900 text-sm leading-snug">{label}</div>
            <div class="text-xs text-slate-500 mt-1">{sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  ABOUT SNIPPET                           ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <span class="text-teal-700 font-semibold text-sm uppercase tracking-wider">About</span>
        <h2 class="text-3xl font-bold text-slate-900 mt-2 mb-5">Public Health Meets Clinical Expertise</h2>
        <p class="text-slate-600 leading-relaxed mb-4">
          Accomplished public health professional and dentist with a Master of Public Health (MPH), recognised as a
          university gold medalist. Experienced in designing, delivering, and coordinating MOOC and community health
          initiatives for frontline health workers, reaching diverse populations with innovative, evidence-based oral
          health solutions.
        </p>
        <p class="text-slate-600 leading-relaxed mb-6">
          Passionate about bridging knowledge gaps and supporting upskilling among frontline health workers, I aim
          to advance health equity through accessible education.
        </p>
        <a href="/about" class="inline-flex items-center gap-2 text-teal-700 font-semibold hover:gap-3 transition-all">
          Read full bio
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Skills -->
      <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200">
        <h3 class="font-semibold text-slate-900 mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
          Skills & Tools
        </h3>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 text-sm font-medium shadow-sm">
              {skill}
            </span>
          ))}
        </div>

        <div class="mt-6 pt-5 border-t border-slate-200">
          <h4 class="text-xs text-slate-500 uppercase tracking-wider font-semibold mb-3">Focus Areas</h4>
          <ul class="space-y-2 text-sm text-slate-600">
            {[
              'Oral Health & NCD Prevention',
              'MOOC & Digital Health Education',
              'Community Health & Policy',
              'Geospatial Health Data Analysis',
              'Mental Health Advocacy',
            ].map((area) => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {area}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  FEATURED RESEARCH                       ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="bg-slate-100 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <span class="text-teal-700 font-semibold text-sm uppercase tracking-wider">Research</span>
          <h2 class="text-3xl font-bold text-slate-900 mt-1">Featured Work</h2>
        </div>
        <a href="/research" class="text-teal-700 font-semibold text-sm hover:underline hidden sm:block">View all →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {featured.map((entry) => (
          <ResearchCard
            slug={entry.slug}
            title={entry.data.title}
            authors={entry.data.authors}
            venue={entry.data.venue}
            date={entry.data.date}
            category={entry.data.category}
            abstract={entry.data.abstract}
            cover={entry.data.cover}
            url={entry.data.url}
            pdf={entry.data.pdf}
          />
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/research" class="text-teal-700 font-semibold">View all research →</a>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  HEALTH EDUCATION                        ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <span class="text-teal-700 font-semibold text-sm uppercase tracking-wider">Health Education</span>
          <h2 class="text-3xl font-bold text-slate-900 mt-1">Learning Resources</h2>
        </div>
        <a href="/health-education" class="text-teal-700 font-semibold text-sm hover:underline hidden sm:block">View all →</a>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {featuredHealthEd.map((mod) => (
          <HealthEducationCard
            slug={mod.slug}
            title={mod.data.title}
            description={mod.data.description}
            date={mod.data.date}
            category={mod.data.category}
            format={mod.data.format}
            duration={mod.data.duration}
            difficulty={mod.data.difficulty}
            targetAudience={mod.data.targetAudience}
            cover={mod.data.cover}
            url={mod.data.url}
          />
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/health-education" class="text-teal-700 font-semibold">View all learning resources →</a>
      </div>
    </div>
  </section>

  <!-- ╔══════════════════════════════════════════╗ -->
  <!-- ║  CURRENT ROLE CTA                        ║ -->
  <!-- ╚══════════════════════════════════════════╝ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="bg-gradient-to-br from-teal-700 to-sky-700 rounded-3xl p-10 md:p-14 text-white text-center shadow-xl">
      <h2 class="text-3xl font-bold mb-3">Open to Collaborations</h2>
      <p class="text-teal-100 text-lg mb-8 max-w-2xl mx-auto">
        Available for research collaborations, MOOC development, policy analysis projects,
        and health program coordination opportunities.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="mailto:drshivania07@gmail.com"
           class="px-6 py-3 bg-white text-teal-800 rounded-xl font-semibold hover:shadow-lg transition-all">
          Get in Touch
        </a>
        <a href="https://www.linkedin.com/in/shivani-arun/" target="_blank" rel="noopener noreferrer"
           class="px-6 py-3 bg-white/15 border border-white/30 rounded-xl font-semibold hover:bg-white/25 transition-all">
          LinkedIn Profile
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
